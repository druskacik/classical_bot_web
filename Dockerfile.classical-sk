FROM node:24.18.0-alpine AS build

WORKDIR /usr/src/nuxt-app

COPY package.json package-lock.json ./
RUN npm ci

COPY . ./
# Build the Slovak application without the local development dotenv option.
RUN ./node_modules/.bin/nuxt build apps/classical-sk

FROM node:24.18.0-alpine AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
WORKDIR /usr/src/nuxt-app

COPY --from=build --chown=node:node /usr/src/nuxt-app/apps/classical-sk/.output ./.output

USER node
EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
