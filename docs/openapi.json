                    "null"
                  ],
                  "pattern": "^\\d+(\\.\\d+)?$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "audience": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "conditions": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "basis": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "admission_type": {
            "description": "Admission category.",
            "type": [
              "string",
              "null"
            ]
          },
          "booking_kind": {
            "description": "Booking method.",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "purchase",
              "reservation",
              null
            ]
          },
