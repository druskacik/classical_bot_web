              "on_sale",
              "not_yet_on_sale",
              "sold_out",
              "box_office_only",
              "not_required",
              null
            ]
          },
          "on_sale_at": {
            "description": "When booking opens.",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_id": {
            "description": "ClassicalBot source ID.",
            "type": ["string", "null"],
            "pattern": "^[0-9]+$"
          },
          "source_name": {
            "description": "Source name.",
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "description": "Source URL.",
            "type": [
              "string",
              "null"
            ]
          },
          "source_event_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Concert links from its sources."
          }
        }
      },
      "ConcertResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "concerts",
          "pagination",
          "generated_at"
        ],
        "properties": {
