{
  "openapi": "3.1.0",
  "info": {
    "title": "ClassicalBot Concert API",
    "version": "1.1.0",
    "description": "Unauthenticated concert discovery by organisation, country, city, performer and venue. Filters combine with AND. Entity lookup returns canonical ID strings. JSON and CSV use identical concert fields. CSV detail arrays are JSON text inside cells. Upcoming means today onward in UTC. State is currently unavailable."
  },
  "servers": [
    {
      "url": "https://classicalbot.com"
    },
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/v1/cities": {
      "get": {
        "operationId": "searchCities", "summary": "Find canonical cities by English or local name", "security": [],
        "description": "Read-only, case- and accent-insensitive substring search with literal punctuation. Known cities remain discoverable without upcoming concerts unless has_upcoming=true. IDs are internal canonical IDs, not external GeoNames IDs. Results are cached for up to 120 seconds. Unknown or repeated parameters are rejected. Limits are shared with the other v1 endpoints: 60 requests/minute/IP per process.",
        "parameters": [
          { "$ref": "#/components/parameters/SearchQuery" }, { "$ref": "#/components/parameters/CountryCode" },
          { "$ref": "#/components/parameters/HasUpcoming" }, { "$ref": "#/components/parameters/LookupPage" }, { "$ref": "#/components/parameters/LookupPageSize" }
        ],
        "responses": {
          "200": { "description": "Matched cities, or an empty collection.", "headers": { "X-Total-Count": { "schema": { "type": "integer" } }, "Link": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CityResponse" } } } },
          "400": { "$ref": "#/components/responses/LookupError" }, "422": { "$ref": "#/components/responses/LookupError" },
          "429": { "$ref": "#/components/responses/RetryError" }, "500": { "$ref": "#/components/responses/LookupError" }, "503": { "$ref": "#/components/responses/RetryError" }
        }
      },
      "options": { "summary": "Public CORS preflight", "responses": { "204": { "description": "GET and OPTIONS allowed without credentials." } } }
    },
    "/api/v1/performers": {
      "get": {
        "operationId": "searchPerformers", "summary": "Find canonical performers by name or alias", "security": [],
        "description": "Read-only normalized substring search of canonical names and stored aliases. Matches are case- and accent-insensitive. Includes people and ensembles without inferring membership; no nationality filter. Known performers remain discoverable without upcoming concerts unless has_upcoming=true. Results are cached for up to 120 seconds. Unknown or repeated parameters are rejected. Shares the v1 rate limit.",
        "parameters": [
          { "$ref": "#/components/parameters/SearchQuery" }, { "$ref": "#/components/parameters/HasUpcoming" },
          { "$ref": "#/components/parameters/LookupPage" }, { "$ref": "#/components/parameters/LookupPageSize" }
        ],
        "responses": {
          "200": { "description": "Matched performers, or an empty collection.", "headers": { "X-Total-Count": { "schema": { "type": "integer" } }, "Link": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PerformerResponse" } } } },
          "400": { "$ref": "#/components/responses/LookupError" }, "422": { "$ref": "#/components/responses/LookupError" },
          "429": { "$ref": "#/components/responses/RetryError" }, "500": { "$ref": "#/components/responses/LookupError" }, "503": { "$ref": "#/components/responses/RetryError" }
        }
      },
      "options": { "summary": "Public CORS preflight", "responses": { "204": { "description": "GET and OPTIONS allowed without credentials." } } }
    },
    "/api/v1/venues": {
      "get": {
        "operationId": "searchVenues", "summary": "Find canonical venues by name or alias", "security": [],
        "description": "Read-only normalized, case- and accent-insensitive substring search of canonical names and stored aliases. Optional city/country restrictions combine with AND. Known venues remain discoverable without upcoming concerts unless has_upcoming=true. Parent buildings do not implicitly include halls. Results are cached for up to 120 seconds. Unknown or repeated parameters are rejected. Shares the v1 rate limit.",
        "parameters": [
          { "$ref": "#/components/parameters/SearchQuery" }, { "$ref": "#/components/parameters/CountryCode" }, { "$ref": "#/components/parameters/CityId" },
          { "$ref": "#/components/parameters/HasUpcoming" }, { "$ref": "#/components/parameters/LookupPage" }, { "$ref": "#/components/parameters/LookupPageSize" }
        ],
        "responses": {
          "200": { "description": "Matched venues, or an empty collection.", "headers": { "X-Total-Count": { "schema": { "type": "integer" } }, "Link": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueResponse" } } } },
          "400": { "$ref": "#/components/responses/LookupError" }, "422": { "$ref": "#/components/responses/LookupError" },
          "429": { "$ref": "#/components/responses/RetryError" }, "500": { "$ref": "#/components/responses/LookupError" }, "503": { "$ref": "#/components/responses/RetryError" }
        }
      },
      "options": { "summary": "Public CORS preflight", "responses": { "204": { "description": "GET and OPTIONS allowed without credentials." } } }
    },
    "/api/v1/concerts": {
      "get": {
        "operationId": "listOrganisationConcerts",
        "summary": "Upcoming concerts matching composable organisation, location, performer and venue filters",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "url",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Organisation HTTP(S) URL. Bare hostnames are accepted. At least one of url, country_code, city_id, performer_id or venue_id is required."
          },
          { "$ref": "#/components/parameters/CountryCode" },
          { "$ref": "#/components/parameters/CityId" },
          {
            "in": "query", "name": "performer_id", "required": false,
            "schema": { "$ref": "#/components/schemas/EntityId" },
            "description": "Exact credited performer ID; includes people and ensembles without inferred membership."
          },
          {
            "in": "query", "name": "venue_id", "required": false,
            "schema": { "$ref": "#/components/schemas/EntityId" },
            "description": "Exact venue or hall ID. Parent buildings do not implicitly include their halls."
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            },
            "description": "Response representation; does not change selected records."
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            },
            "description": "Page number. Incompatible with all=true."
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Records per page. Incompatible with all=true."
          },
          {
            "in": "query",
            "name": "all",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Complete export, maximum 10000 concerts. Serialized responses are capped at 20 MiB."
          }
        ],
        "responses": {
          "200": {
            "description": "Concerts or an empty collection. CSV is UTF-8 with BOM, quoted comma-separated fields and CRLF. Nulls are blank; arrays are JSON cells. Formula-like scalar text is prefixed with an apostrophe. CSV headers exactly follow Concert property order. Blocked, disabled or needs-attention sources with zero concerts return JSON with a message even when CSV is requested.",
            "headers": {
              "X-Total-Count": {
                "schema": {
                  "type": "integer"
                },
                "description": "Total matching primary concerts"
              },
              "Link": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative next-page URL, when available"
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"concerts.csv\" for CSV"
              },
              "X-Source-Status": {
                "schema": {
                  "type": "string"
                },
                "description": "Current crawler registry status; active does not guarantee completed ingestion or enrichment."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConcertResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                },
                "example": "\"artists\",\"date\",\"time\",\"venue_name\",\"city\",\"state\",\"country\",\"venue_address\",\"buy_url\",\"id\",\"title\",\"event_url\",\"end_time\",\"event_status\",\"last_verified_at\",\"country_code\",\"city_id\",\"venue_id\",\"venue_url\",\"parent_venue_name\",\"latitude\",\"longitude\",\"programme\",\"programme_items\",\"composers\",\"performers\",\"prices\",\"price_items\",\"admission_type\",\"booking_kind\",\"booking_status\",\"on_sale_at\",\"source_id\",\"source_name\",\"source_url\",\"source_event_urls\"\r\n"
              }
            }
          },
          "400": {
            "description": "JSON error, including when format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown source while registration is disabled. JSON even for format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid/non-public website, ambiguous source, or oversized export. JSON even for format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "JSON error, including when format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before retrying"
              }
            }
          },
          "500": {
            "description": "JSON error, including when format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "202": {
            "description": "No concerts yet; source is pending, processing, pr_open or retry_wait. Always JSON, even for format=csv. Poll the same URL.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Suggested polling interval in seconds"
              },
              "X-Source-Status": {
                "schema": {
                  "type": "string"
                },
                "description": "Current crawler registry status; active does not guarantee completed ingestion or enrichment."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConcertResponse"
                }
              }
            }
          },
          "503": {
            "description": "Concert catalogue or DNS validation temporarily unavailable. Retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Supply at least one of url, country_code, city_id, performer_id or venue_id. All supplied filters combine with AND. Unknown IDs or contradictory filters return an empty collection. Requests without url are read-only and have source: null; every concert has its own attribution. Next links retain every filter. When url is supplied and registration is enabled, unknown public websites are DNS-validated and queued at priority 100. When enabled, this GET can create a source or raise an existing pending, processing, pr_open, retry_wait, or active source to at least priority 100, preserving higher priorities and retry timing. Aliases and duplicates promote the resolved primary source. Disabled registration keeps lookup read-only. Repeat the same request to poll registry status; active does not imply completed concert enrichment."
      },
      "options": {
        "summary": "Public CORS preflight",
        "responses": {
          "204": {
            "description": "GET and OPTIONS permitted without credentials"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "LookupError": {
        "description": "JSON error: invalid_parameter (400), export_too_large if a serialized page exceeds 20 MiB (422), or internal_error (500).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RetryError": {
        "description": "JSON error: rate_limited (429) or catalogue_unavailable (503).",
        "headers": { "Retry-After": { "schema": { "type": "integer" }, "description": "Seconds before retrying" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "parameters": {
      "CountryCode": {
        "in": "query", "name": "country_code", "required": false,
        "schema": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
        "description": "ISO alpha-2 concert/entity location code, normalized to uppercase; not performer nationality."
      },
      "CityId": {
        "in": "query", "name": "city_id", "required": false,
        "schema": { "$ref": "#/components/schemas/EntityId" },
        "description": "Exact canonical city ID; not a GeoNames ID. No nearby-city expansion."
      },
      "SearchQuery": {
        "in": "query", "name": "q", "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": "Nonblank searchable text. Normalized substring search; no typo correction. Exact matches rank before prefixes and other substrings, then name and ID."
      },
      "HasUpcoming": {
        "in": "query", "name": "has_upcoming", "required": false,
        "schema": { "type": "boolean", "default": false },
        "description": "Restrict to identities linked to a published upcoming concert. Exact city/venue/credited-performer semantics."
      },
      "LookupPage": {
        "in": "query", "name": "page", "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 }
      },
      "LookupPageSize": {
        "in": "query", "name": "page_size", "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "EntityId": {
        "type": "string", "pattern": "^[1-9][0-9]{0,18}$", "maxLength": 19,
        "description": "Positive PostgreSQL bigint ID, maximum 9223372036854775807. Preserve as a string."
      },
      "City": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "local_name", "country_code", "latitude", "longitude", "external_source", "external_id"],
        "properties": {
          "id": { "$ref": "#/components/schemas/EntityId" },
          "name": { "type": ["string", "null"] },
          "local_name": { "type": ["string", "null"] },
          "country_code": { "type": ["string", "null"] },
          "latitude": { "type": ["number", "null"] },
          "longitude": { "type": ["number", "null"] },
          "external_source": { "type": ["string", "null"] },
          "external_id": { "type": ["string", "null"], "description": "External identity, e.g. GeoNames; do not substitute for city_id." }
        }
      },
      "Performer": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "kind", "ensemble_type", "identity_url"],
        "properties": {
          "id": { "$ref": "#/components/schemas/EntityId" },
          "name": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "ensemble_type": { "type": ["string", "null"] },
          "identity_url": { "type": ["string", "null"] }
        }
      },
      "Venue": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "country_code", "city", "address", "identity_url", "latitude", "longitude", "parent_venue"],
        "properties": {
          "id": { "$ref": "#/components/schemas/EntityId" },
          "name": { "type": ["string", "null"] },
          "country_code": { "type": ["string", "null"] },
          "city": {
            "type": ["object", "null"], "additionalProperties": false, "required": ["id", "name", "country_code"],
            "properties": {
              "id": { "$ref": "#/components/schemas/EntityId" },
              "name": { "type": ["string", "null"] },
              "country_code": { "type": ["string", "null"] }
            }
          },
          "address": { "type": ["string", "null"] },
          "identity_url": { "type": ["string", "null"] },
          "latitude": { "type": ["number", "null"] },
          "longitude": { "type": ["number", "null"] },
          "parent_venue": {
            "type": ["object", "null"], "additionalProperties": false, "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/components/schemas/EntityId" },
              "name": { "type": ["string", "null"] }
            }
          }
        }
      },
      "EntityPagination": {
        "type": "object", "additionalProperties": false,
        "required": ["page", "page_size", "total", "total_pages", "next"],
        "properties": {
          "page": { "type": "integer" }, "page_size": { "type": "integer" },
          "total": { "type": "integer" }, "total_pages": { "type": "integer" },
          "next": { "type": ["string", "null"] }
        }
      },
      "CityResponse": {
        "type": "object", "additionalProperties": false, "required": ["items", "pagination", "generated_at"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/City" } },
          "pagination": { "$ref": "#/components/schemas/EntityPagination" },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PerformerResponse": {
        "type": "object", "additionalProperties": false, "required": ["items", "pagination", "generated_at"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Performer" } },
          "pagination": { "$ref": "#/components/schemas/EntityPagination" },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      },
      "VenueResponse": {
        "type": "object", "additionalProperties": false, "required": ["items", "pagination", "generated_at"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Venue" } },
          "pagination": { "$ref": "#/components/schemas/EntityPagination" },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Concert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artists",
          "date",
          "time",
          "venue_name",
          "city",
          "state",
          "country",
          "venue_address",
          "buy_url",
          "id",
          "title",
          "event_url",
          "end_time",
          "event_status",
          "last_verified_at",
          "country_code",
          "city_id",
          "venue_id",
          "venue_url",
          "parent_venue_name",
          "latitude",
          "longitude",
          "programme",
          "programme_items",
          "composers",
          "performers",
          "prices",
          "price_items",
          "admission_type",
          "booking_kind",
          "booking_status",
          "on_sale_at",
          "source_id",
          "source_name",
          "source_url",
          "source_event_urls"
        ],
        "properties": {
          "artists": {
            "type": [
              "string",
              "null"
            ],
            "description": "Semicolon-separated unique credited performer names."
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "venue_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Canonical hall name, falling back to the original concert venue."
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "null",
            "description": "State/region is not currently stored."
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue_address": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer Venue column provisionally means address."
          },
          "buy_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stored occurrence-specific booking URL; no homepage fallback."
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Primary concert event page, potentially on another source."
          },
          "end_time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
          },
          "event_status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled",
              "postponed",
              "rescheduled"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$"
          },
          "city_id": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+$",
            "description": "Canonical city ID, distinct from any external GeoNames identifier."
          },
          "venue_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_venue_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "programme": {
            "type": [
              "string",
              "null"
            ],
            "description": "Readable programme summary; ordering is not performance order."
          },
          "programme_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "programme_label",
                "catalogue_number",
                "composer"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "title": {
                  "type": "string"
                },
                "programme_label": {
                  "type": "string"
                },
                "catalogue_number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "composer": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "composers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "performers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "kind",
                "roles",
                "instruments",
                "voice_type",
                "character",
                "ensemble",
                "qualifier",
                "identity_url"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "person",
                    "ensemble"
                  ]
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string"
